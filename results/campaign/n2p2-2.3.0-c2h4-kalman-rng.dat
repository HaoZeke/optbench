nfailed 40
cap 10000
counter harness
code n2p2
code_version 2.3.0
commit 29b9c9f10b1ac9ea45631b3d556a129ca3b701c2
algorithm Kalman
template n2p2/c2h4-kalman-rng
problem mlopt/C2H4
tuning n2p2-rng
mean_force_rmse -1.0
median_force_rmse -1.0
force_calls 6986
mean_epoch 6985.60000000
median_epoch 6863.00000000
mean_energy_rmse 0.0007603827360740159
median_energy_rmse 0.0006456962491406181
par2_mean 17397.12
median 20000.0
