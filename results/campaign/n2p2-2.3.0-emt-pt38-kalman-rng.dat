# n2p2 standard Kalman filter on the pyamff energy-only squared error.
# One force call is one loss-gradient evaluation. The filter updates once per structure.
# Structure order is n2p2 std::shuffle with random_seed 1234567.
# Weights stay the PCG64 uniform[-1, 1) draw used by the permutation row.
# loss commit 8037eb98e2288c132c112aa6c2032f00cd5c5277. gradient tolerance 0.02. force RMSE is -1.0 because forces are not trained.
n 50
nfailed 0
cap 10000
counter harness
code n2p2
code_version 2.3.0
commit 29b9c9f10b1ac9ea45631b3d556a129ca3b701c2
algorithm Kalman
template n2p2/emt-pt38-kalman-rng
problem mlopt/emt-pt38
tuning n2p2-rng
mean_force_rmse -1.0
median_force_rmse -1.0
force_calls 25
mean_epoch 25.02000000
median_epoch 14.00000000
mean_energy_rmse 0.0008328850546985311
median_energy_rmse 0.0006934252205119476
par2_mean 25.02
median 14.0
median_low 12.9875
median_high 22.5
wilson_low 0.9286524008666414
wilson_high 1.0
n_cap 0
n_divergence 0
n_crash 0
n_wrong_stationary 0
