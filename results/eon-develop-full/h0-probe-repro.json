{
  "eon_commit": "7095b23ac17d49f434a5e08ccb072897ceca698e",
  "svn": "r2549",
  "dimer_commit": {
    "sha": "3af36c235625357817c2110e810c715608635866",
    "parent": "825fb17d9808d6c8198692b64da2a26c8b277891",
    "date": "2026-09-30",
    "summary": "LBFGS::getStep uses ObjectiveFunction::knownCurvature. MinModeObjectiveFunction returns -eigenvalue once its iteration is no longer 0. LBFGS::step calls getGradient, which increments that iteration, before getStep. The first translation therefore uses H0 = 1/|eigenvalue| and skips the finite-difference probe."
  },
  "neb_probe_commit": {
    "sha": "8c4198ef3444",
    "parent": "fd25c4b54230139d235bd8276701f401e7fa127b",
    "date": "2026-09-28",
    "summary": "NEBObjectiveFunction::supportsFiniteDifferenceCurvature returns false, so the first band step keeps inverse_curvature 0.01."
  },
  "neb_repick_commit": {
    "sha": "ed3ad27a9b0094a16a6db22a640226570114945d",
    "parent": "c5d2e5abdea698793ce6132814f5998f4e0e67a3",
    "date": "2026-10-04",
    "summary": "The climbing image stays on the previous interior local maximum. r2549 selects the current highest image on every iteration."
  },
