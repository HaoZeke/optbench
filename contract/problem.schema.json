{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lode-org.github.io/optbench/contract/problem.schema.json",
  "title": "OptBench problem",
  "type": "object",
  "required": ["schema", "id", "geometries", "convergence", "reducer", "metrics"],
  "properties": {
    "schema": { "const": "optbench.problem/v1" },
    "id": { "type": "string" },
    "title": { "type": "string" },
    "geometries": {
      "type": "object",
      "required": ["sha256", "count"],
      "properties": {
        "archive_path": { "type": "string" },
        "sha256": { "type": "string" },
        "count": { "type": "integer" },
        "atoms": { "type": "integer" }
      }
    },
    "potential": { "type": "object" },
    "convergence": {
      "type": "object",
      "required": ["metric", "force_norm", "max_force_calls"],
      "properties": {
        "metric": { "enum": ["l2"] },
        "force_norm": { "type": "number" },
        "max_force_calls": { "type": "integer" }
      }
    },
    "reducer": { "type": "object" },
    "metrics": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
